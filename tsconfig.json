{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // The Svelte TypeScript plugin also scans these paths for component files.
  // Keep cached workspaces, dependencies and generated output out of the project.
  "exclude": [
    "**/.git/**",
    "**/.delta/**",
    "**/.local/**",
    "**/node_modules/**",
    "**/.cache/**",
    "**/.svelte-kit/**",
    "**/.wrangler/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/coverage/**",
    "fixtures/**",
    "output/**",
    "tmp/**"
  ]
}
