{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!fixtures/**/*.json",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!apps/atlas-api/worker-configuration.d.ts",
      "!**/*.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConfusingVoidType": "off"
      },
      "correctness": {
        "noUnknownPseudoElement": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "trailingCommas": "all"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "json": {
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 88,
      "trailingCommas": "none",
      "bracketSpacing": true
    },
    "assist": {
      "enabled": false
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": false
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["fixtures/meta/**/*.md"],
      "markdown": {
        "formatter": {
          "formatEmbeds": false
        }
      }
    },
    {
      "includes": ["**/tsconfig*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/build-island-review-inventory.ts",
        "scripts/divisions/prepare-review.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": {
              "level": "warn",
              "options": {
                "allowedEnvVars": [
                  "SAANSEOI_REVIEW_API_URL",
                  "SAANSEOI_REVIEW_ARCHIVE_URL",
                  "SAANSEOI_REVIEW_OPTIONS"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "markdown": {
    "formatter": {
      "enabled": true,
      "proseWrap": "always"
    },
    "parser": {
      "frontmatter": true
    }
  }
}
