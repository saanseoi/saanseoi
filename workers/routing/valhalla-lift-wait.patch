+
+TEST_F(Indoor, ElevatorWaitAddsElapsedTime) {
+  // Edge and node elevators both add one boarding wait, independent of levels travelled.
+  for (const auto& endpoints : std::vector<std::vector<std::string>>{{"F", "I"}, {"I", "F"},
+                                                                   {"H", "J"}, {"J", "H"},
+                                                                   {"H", "Q"}, {"Q", "H"}}) {
+    for (const auto& date_type : {"", "0", "2"}) {
+      std::unordered_map<std::string, std::string> options{
+          {"/date_time/type", date_type}, {"/date_time/value", "2024-01-01T10:00"},
+          {"/locations/0/node_snap_tolerance", "0"},
+          {"/locations/1/node_snap_tolerance", "0"}};
+      if (std::string(date_type).empty()) {
+        options.erase("/date_time/type");
+        options.erase("/date_time/value");
+      }
+      const std::unordered_map<std::string, std::string> levels{{"F", "1"}, {"I", "2"}, {"H", "2"}, {"J", "3"}, {"Q", "17"}};
+      options["/locations/0/search_filter/level"] = levels.at(endpoints.front());
+      options["/locations/1/search_filter/level"] = levels.at(endpoints.back());
+      auto baseline = gurka::do_action(valhalla::Options::route, map, endpoints, "pedestrian", options);
+      options["/costing_options/pedestrian/elevator_wait"] = "30";
+      auto waited = gurka::do_action(valhalla::Options::route, map, endpoints, "pedestrian", options);
+      const auto& before = baseline.trip().routes(0).legs(0).node();
+      const auto& after = waited.trip().routes(0).legs(0).node();
+      ASSERT_EQ(before.size(), after.size());
+      EXPECT_NEAR(after.rbegin()->cost().elapsed_cost().seconds() -
+                      before.rbegin()->cost().elapsed_cost().seconds(), 30.f, 0.01f);
+      EXPECT_NEAR(after.rbegin()->cost().elapsed_cost().cost() -
+                      before.rbegin()->cost().elapsed_cost().cost(), 30.f, 0.01f);
+    }
+  }
+}
+
+TEST(StandAlone, ElevatorWaitOnceAcrossSegments) {
+  // Two consecutive lift ways represent one ride; a corridor separates the next ride.
+  const std::string ascii_map = "A---B---C---D---E---F---G";
+  const gurka::ways ways = {
+      {"AB", {{"highway", "corridor"}, {"level", "0"}}},
+      {"BC", {{"highway", "elevator"}, {"level", "0;1"}}},
+      {"CD", {{"highway", "elevator"}, {"level", "1;2"}}},
+      {"DE", {{"highway", "corridor"}, {"level", "2"}}},
+      {"EF", {{"highway", "elevator"}, {"level", "2;3"}}},
+      {"FG", {{"highway", "corridor"}, {"level", "3"}}},
+  };
+  const auto layout = gurka::detail::map_to_coordinates(ascii_map, 10);
+  auto map = gurka::buildtiles(layout, ways, {}, {}, "test/data/gurka_elevator_wait_segments", build_config);
+  for (const auto& endpoints : std::vector<std::vector<std::string>>{{"A", "E"}, {"E", "A"},
+                                                                   {"A", "G"}, {"G", "A"}}) {
+    for (const auto& date_type : {"", "0", "2"}) {
+      std::unordered_map<std::string, std::string> options{
+          {"/date_time/type", date_type}, {"/date_time/value", "2024-01-01T10:00"},
+          {"/locations/0/search_cutoff", "1"}, {"/locations/1/search_cutoff", "1"},
+          {"/locations/0/node_snap_tolerance", "0"}, {"/locations/1/node_snap_tolerance", "0"}};
+      if (std::string(date_type).empty()) {
+        options.erase("/date_time/type");
+        options.erase("/date_time/value");
+      }
+      auto baseline = gurka::do_action(valhalla::Options::route, map, endpoints, "pedestrian", options);
+      options["/costing_options/pedestrian/elevator_wait"] = "30";
+      auto waited = gurka::do_action(valhalla::Options::route, map, endpoints, "pedestrian", options);
+      const float expected = endpoints.front() == "G" || endpoints.back() == "G" ? 60.f : 30.f;
+      const auto& before = baseline.trip().routes(0).legs(0).node();
+      const auto& after = waited.trip().routes(0).legs(0).node();
+      EXPECT_NEAR(after.rbegin()->cost().elapsed_cost().seconds() -
+                      before.rbegin()->cost().elapsed_cost().seconds(), expected, 0.1f);
+    }
+  }
+}
+
+TEST(StandAlone, ElevatorWaitChangesRouteChoice) {
+  // Waiting changes the selected path, not just the displayed ETA.
+  const std::string ascii_map = R"(
+    A---B---C---D
+        |   |
+        E---F
+  )";
+  const gurka::ways ways = {
+      {"AB", {{"highway", "corridor"}, {"level", "0"}}},
+      {"BC", {{"highway", "elevator"}, {"level", "0;1"}}},
+      {"CD", {{"highway", "corridor"}, {"level", "1"}}},
+      {"BE", {{"highway", "steps"}, {"level", "0;1"}}},
+      {"EF", {{"highway", "corridor"}, {"level", "1"}}},
+      {"FC", {{"highway", "corridor"}, {"level", "1"}}},
+  };
+  const auto layout = gurka::detail::map_to_coordinates(ascii_map, 10);
+  auto map = gurka::buildtiles(layout, ways, {}, {}, "test/data/gurka_elevator_wait_choice", build_config);
+  std::unordered_map<std::string, std::string> options{
+      {"/locations/0/search_cutoff", "1"}, {"/locations/1/search_cutoff", "1"},
+      {"/costing_options/pedestrian/step_penalty", "0"}};
+  auto direct = gurka::do_action(valhalla::Options::route, map, {"A", "D"}, "pedestrian", options);
+  gurka::assert::raw::expect_path(direct, {"AB", "BC", "CD"});
+  options["/costing_options/pedestrian/elevator_wait"] = "120";
+  auto detour = gurka::do_action(valhalla::Options::route, map, {"A", "D"}, "pedestrian", options);
+  gurka::assert::raw::expect_path(detour, {"AB", "BE", "EF", "FC", "CD"});
+}
+
+TEST(StandAlone, ElevatorWaitSameAndFractionalFloors) {
+  const auto layout = gurka::detail::map_to_coordinates("A---B---C", 10);
+  for (const auto& target_level : {"0", "0.5"}) {
+    const gurka::ways ways = {
+        {"AB", {{"highway", "corridor"}, {"level", "0"}}},
+        {"BC", {{"highway", "corridor"}, {"level", target_level}}},
+    };
+    const gurka::nodes nodes = {{"B", {{"highway", "elevator"}, {"level", "0;0.5"}}}};
+    auto map = gurka::buildtiles(layout, ways, nodes, {},
+                                std::string("test/data/gurka_elevator_wait_floor_") + target_level, build_config);
+    auto baseline = gurka::do_action(valhalla::Options::route, map, {"A", "C"}, "pedestrian");
+    auto waited = gurka::do_action(valhalla::Options::route, map, {"A", "C"}, "pedestrian",
+                                  {{"/costing_options/pedestrian/elevator_wait", "30"}});
+    const float expected = std::string(target_level) == "0" ? 0.f : 30.f;
+    EXPECT_NEAR(waited.trip().routes(0).legs(0).node().rbegin()->cost().elapsed_cost().seconds() -
+                    baseline.trip().routes(0).legs(0).node().rbegin()->cost().elapsed_cost().seconds(),
+                expected, 0.01f);
+  }
+}
+
+TEST(StandAlone, ElevatorWaitAtCoincidentLandings) {
+  // Distinct source landing nodes can have identical XY. Correlation must retain their floors.
+  auto layout = gurka::detail::map_to_coordinates("A---B---C---D", 10);
+  layout["C"] = layout["B"];
+  const gurka::ways ways = {
+      {"AB", {{"highway", "corridor"}, {"level", "0"}}},
+      {"BC", {{"highway", "elevator"}, {"level", "0;1"}}},
+      {"CD", {{"highway", "corridor"}, {"level", "1"}}},
+  };
+  auto map = gurka::buildtiles(layout, ways, {}, {}, "test/data/gurka_elevator_wait_landings", build_config);
+  for (const auto& endpoints : std::vector<std::vector<std::string>>{{"B", "C"}, {"C", "B"}}) {
+    for (const auto& tolerance : {"0", "5"}) {
+      auto waited = gurka::do_action(valhalla::Options::route, map, endpoints, "pedestrian",
+          {{"/costing_options/pedestrian/elevator_wait", "30"},
+           {"/locations/0/search_filter/level", endpoints.front() == "B" ? "0" : "1"},
+           {"/locations/1/search_filter/level", endpoints.back() == "C" ? "1" : "0"},
+           {"/locations/0/node_snap_tolerance", tolerance},
+           {"/locations/1/node_snap_tolerance", tolerance},
+           {"/locations/0/search_cutoff", "1"}, {"/locations/1/search_cutoff", "1"},
+           {"/locations/0/minimum_reachability", "0"}, {"/locations/1/minimum_reachability", "0"}});
+      gurka::assert::raw::expect_path(waited, endpoints.front() == "B" ?
+          std::vector<std::string>{"AB", "BC", "CD"} : std::vector<std::string>{"CD", "BC", "AB"});
+      EXPECT_GE(waited.trip().routes(0).legs(0).node().rbegin()->cost().elapsed_cost().seconds(), 30.f);
+      EXPECT_LT(waited.trip().routes(0).legs(0).node().rbegin()->cost().elapsed_cost().seconds(), 32.f);
+    }
+  }
+}
