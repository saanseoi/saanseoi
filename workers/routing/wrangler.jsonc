{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ss-routing-prod",
  "main": "index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["ROUTING_CLIENTS"]
  },
  "containers": [
    {
      "class_name": "NativeRouting",
      "image": "./Dockerfile",
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 2000
      },
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NATIVE",
        "class_name": "NativeRouting"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NativeRouting"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "preview": {
      "secrets": {
        "required": ["ROUTING_CLIENTS"]
      },
      "containers": [
        {
          "class_name": "NativeRouting",
          "image": "./Dockerfile",
          "instance_type": {
            "vcpu": 1,
            "memory_mib": 3072,
            "disk_mb": 2000
          },
          "max_instances": 2
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NATIVE",
            "class_name": "NativeRouting"
          }
        ]
      },
      "name": "ss-routing-preview",
      "ratelimits": [
        {
          "name": "CLIENT_LIMITER",
          "namespace_id": "43007",
          "simple": {
            "limit": 300,
            "period": 60
          }
        }
      ]
    }
  },
  "ratelimits": [
    {
      "name": "CLIENT_LIMITER",
      "namespace_id": "43006",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
