{
  "name": "saanseoi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.0",
  "bin": {
    "saanseoi": "./bin/saanseoi"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bash ./scripts/dev.sh all",
    "dev:all": "bash ./scripts/dev.sh all",
    "dev:atlas": "bash ./scripts/dev.sh atlas",
    "dev:harbour": "bash ./scripts/dev.sh harbour",
    "dev:basemap": "bun run --filter=basemap-viewer dev",
    "update": "bun update --interactive --recursive",
    "outdated": "bun outdated --recursive",
    "upload": "./bin/saanseoi upload",
    "dataops": "SAANSEOI_INVOCATION_CWD=\"$PWD\" bun --env-file=\"$PWD/.env\" --env-file=\"$PWD/.env.local\" --cwd ./apps/harbour-dataops ./src/cli.ts",
    "bridge:telegram-discord": "bun run --cwd ./apps/telegram-discord-bridge deploy",
    "datasets:update": "./bin/saanseoi update",
    "upload:preview": "./bin/saanseoi upload --target preview",
    "upload:production": "./bin/saanseoi upload --target production",
    "inspect": "./bin/saanseoi inspect",
    "reports:ingestion": "./bin/saanseoi reports:ingestion --target local",
    "reports:ingestion:preview": "./bin/saanseoi reports:ingestion --target preview",
    "reports:ingestion:production": "./bin/saanseoi reports:ingestion --target production",
    "reports:stats": "./bin/saanseoi reports:stats --target local",
    "reports:stats:preview": "./bin/saanseoi reports:stats --target preview",
    "reports:stats:production": "./bin/saanseoi reports:stats --target production",
    "reports:releases": "./bin/saanseoi reports:releases --target local",
    "reports:releases:preview": "./bin/saanseoi reports:releases --target preview",
    "reports:releases:production": "./bin/saanseoi reports:releases --target production",
    "fish:install-completions": "bash ./scripts/install-fish-completions.sh",
    "db:chart": "bun run --filter @repo/db db:chart",
    "db:studio": "bun run --filter @repo/db db:studio",
    "db:studio:preview": "bun run --filter @repo/db db:studio:preview",
    "db:studio:production": "bun run --filter @repo/db db:studio:production",
    "db:studio:meta": "bun run --filter @repo/db db:studio:meta",
    "db:studio:current": "bun run --filter @repo/db db:studio:current",
    "db:studio:history": "bun run --filter @repo/db db:studio:history",
    "db:studio:history:before": "bun run --filter @repo/db db:studio:history:before",
    "db:studio:history:2025": "bun run --filter @repo/db db:studio:history:2025",
    "db:studio:source": "bun run --filter @repo/db db:studio:source",
    "db:studio:source:before": "bun run --filter @repo/db db:studio:source:before",
    "db:studio:source:2025": "bun run --filter @repo/db db:studio:source:2025",
    "db:studio:preview:meta": "bun run --filter @repo/db db:studio:preview:meta",
    "db:studio:preview:current": "bun run --filter @repo/db db:studio:preview:current",
    "db:studio:preview:history": "bun run --filter @repo/db db:studio:preview:history",
    "db:studio:preview:history:2025": "bun run --filter @repo/db db:studio:preview:history:2025",
    "db:studio:preview:source": "bun run --filter @repo/db db:studio:preview:source",
    "db:studio:preview:source:2025": "bun run --filter @repo/db db:studio:preview:source:2025",
    "db:studio:production:meta": "bun run --filter @repo/db db:studio:production:meta",
    "db:studio:production:current": "bun run --filter @repo/db db:studio:production:current",
    "db:studio:production:history": "bun run --filter @repo/db db:studio:production:history",
    "db:studio:production:history:2025": "bun run --filter @repo/db db:studio:production:history:2025",
    "db:studio:production:source": "bun run --filter @repo/db db:studio:production:source",
    "db:studio:production:source:2025": "bun run --filter @repo/db db:studio:production:source:2025",
    "db:dump:preview": "bun run --filter @repo/db db:dump:preview",
    "db:dump:production": "bun run --filter @repo/db db:dump:production",
    "db:snapshot:new:local": "bun run --filter @repo/db db:snapshot:new:local",
    "db:snapshot:new:preview": "bun run --filter @repo/db db:snapshot:new:preview",
    "db:snapshot:new:production": "bun run --filter @repo/db db:snapshot:new:production",
    "db:snapshot:restore:local": "bun run --filter @repo/db db:snapshot:restore:local",
    "db:snapshot:restore:preview": "bun run --filter @repo/db db:snapshot:restore:preview",
    "db:snapshot:restore:production": "bun run --filter @repo/db db:snapshot:restore:production",
    "db:reset:local": "bun run --filter @repo/db db:reset:local",
    "db:reset:preview": "bun run --filter @repo/db db:reset:preview && ./bin/saanseoi docs:publish --target preview --scope all",
    "db:reset:production": "bun run --filter @repo/db db:reset:production && ./bin/saanseoi docs:publish --target production --scope all",
    "db:migration:generate:meta": "bun run --cwd ./libs/db db:migration:generate:meta",
    "db:migration:generate:current": "bun run --cwd ./libs/db db:migration:generate:current",
    "db:migration:generate:history": "bun run --cwd ./libs/db db:migration:generate:history",
    "db:migration:generate:source": "bun run --cwd ./libs/db db:migration:generate:source",
    "db:migration:lint": "bun run --filter @repo/db db:migration:lint",
    "db:migration:lint:meta": "bun run --filter @repo/db db:migration:lint:meta",
    "db:migration:lint:current": "bun run --filter @repo/db db:migration:lint:current",
    "db:migration:lint:history": "bun run --filter @repo/db db:migration:lint:history",
    "db:migration:lint:source": "bun run --filter @repo/db db:migration:lint:source",
    "db:migration:run:local": "bun run --filter @repo/db db:migration:run:local",
    "db:migration:run:local:meta": "bun run --filter @repo/db db:migration:run:local:meta",
    "db:migration:run:preview": "bun run --filter @repo/db db:migration:run:preview",
    "db:migration:run:production": "bun run --filter @repo/db db:migration:run:production",
    "db:import:local": "bun run --filter @repo/db db:import:local",
    "db:rebuild-fts:local": "bun run --filter @repo/db db:rebuild-fts:local",
    "db:mirror:preview:to:local": "bun run --filter @repo/db db:mirror:preview:to:local",
    "db:mirror:production:to:local": "bun run --filter @repo/db db:mirror:production:to:local",
    "db:sync:meta": "bun run --filter @repo/db db:sync:meta",
    "db:sync:preview:meta": "bun run --filter @repo/db db:sync:preview:meta",
    "db:sync:production:meta": "bun run --filter @repo/db db:sync:production:meta",
    "db:list": "bun x wrangler d1 list",
    "d1:recreate": "bun ./scripts/recreate-d1-binding.ts",
    "d1:converge": "bun ./scripts/converge-d1-placement.ts",
    "d1:probe": "bash ./scripts/run-d1-placement-probes.sh preview 20",
    "d1:probe:preview": "bash ./scripts/run-d1-placement-probes.sh preview 20",
    "d1:probe:production": "bash ./scripts/run-d1-placement-probes.sh production 20",
    "workers:provision-renamed": "bun ./scripts/provision-renamed-workers.ts",
    "rehash:fixture": "bun ./scripts/rehash-fixture.ts",
    "test": "turbo run test",
    "test:run": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "build": "turbo run build --filter=atlas-api --filter=atlas-app --filter=basemap-tiles --filter=basemap-viewer --filter=harbour-api --filter=harbour-workers",
    "build:preview": "turbo run build:preview --filter=atlas-api --filter=atlas-app --filter=basemap-viewer --filter=harbour-api --filter=harbour-workers",
    "build:production": "turbo run build:production --filter=atlas-api --filter=atlas-app --filter=basemap-viewer --filter=harbour-api --filter=harbour-workers && bun run --filter=basemap-tiles build",
    "preview": "turbo run preview",
    "check": "turbo run check",
    "format": "biome format --write . && bun run format:markdown",
    "format:markdown": "prettier --write \"**/*.md\" && prettier --parser markdown --write --no-error-on-unmatched-pattern \"**/llms.txt\"",
    "format:markdown:check": "prettier --check \"**/*.md\" && prettier --parser markdown --check --no-error-on-unmatched-pattern \"**/llms.txt\"",
    "deploy": "turbo run deploy --filter=atlas-api --filter=atlas-app --filter=basemap-tiles --filter=basemap-viewer --filter=harbour-api --filter=harbour-workers",
    "deploy:preview": "turbo run deploy:preview --filter=atlas-api --filter=atlas-app --filter=basemap-viewer --filter=harbour-api --filter=harbour-workers",
    "deploy:production": "turbo run deploy:production --filter=atlas-api --filter=atlas-app --filter=basemap-viewer --filter=harbour-api --filter=harbour-workers && bun run --filter=basemap-tiles deploy",
    "lint": "turbo run lint",
    "lint:branch": "bunx branch-name-lint .husky/branch-name-lint.json",
    "machine-translate": "turbo run machine-translate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "cf-typegen": "bun run --workspaces --if-present cf-typegen"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "bits-ui": "^2.19.0",
    "bun-types": "^1.3.14",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify/svelte": "^5.2.2",
    "@tailwindcss/upgrade": "^4.3.3",
    "@types/bun": "latest",
    "branch-name-lint": "^3.0.1",
    "comment-json": "^5.0.0",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "drizzle-migration-lint": "^0.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.10.11",
    "wrangler": "^4.124.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saanseoi/saanseoi.git"
  },
  "author": "tijptjik <m@type.hk>",
  "license": "MIT",
  "homepage": "https://saanseoi.hk",
  "bugs": {
    "url": "https://github.com/saanseoi/saanseoi/issues"
  }
}
