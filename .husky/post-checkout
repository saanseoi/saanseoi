#!/usr/bin/env sh

# Keep ignored local environment files and the local metadata D1 schema
# available in linked worktrees.
# This hook is intentionally non-blocking: a missing Bun executable, a copy
# failure, or a database setup failure must not make `git worktree add` fail.
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Reuse the retained source-data directory from the primary worktree. This
# keeps large ignored Overture inputs available to linked worktrees without
# copying them. Never replace an existing local data directory or link.
primary_worktree=$(git -C "$repo_root" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
data_source="$primary_worktree/data"
data_target="$repo_root/data"
if [ "$repo_root" != "$primary_worktree" ] && [ -d "$data_source" ] && [ ! -e "$data_target" ] && [ ! -L "$data_target" ]; then
    if ! ln -s "$data_source" "$data_target"; then
        echo 'warning: could not link primary worktree data into this worktree' >&2
    fi
fi

if ! command -v bun >/dev/null 2>&1; then
    exit 0
fi

if ! bun "$repo_root/scripts/copy-worktree-local-files.ts"; then
    echo 'warning: could not copy local environment files into this worktree' >&2
fi

# Only initialise metadata for a linked worktree that has no local D1 database
# yet. Ordinary checkout in the primary worktree, and later branch switches in
# an initialised linked worktree, must never reset local development state.
local_d1_dir="$repo_root/.local/d1/dev/v3/d1/miniflare-D1DatabaseObject"
local_database_count=$(find "$local_d1_dir" -maxdepth 1 -type f -name '*.sqlite' ! -name metadata.sqlite 2>/dev/null | wc -l)
if [ "$repo_root" != "$primary_worktree" ] && [ "$local_database_count" -eq 0 ]; then
    if ! (cd "$repo_root" && bun run --filter @repo/db db:reset:local:meta); then
        echo 'warning: could not initialise the local metadata database' >&2
    fi
fi

exit 0
