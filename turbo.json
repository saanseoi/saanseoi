{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*"],
  "globalEnv": ["SAANSEOI_LOCAL_D1_MIGRATIONS_READY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "build:preview": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "build:production": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "atlas-app#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**"]
    },
    "atlas-app#build:preview": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**"]
    },
    "atlas-app#build:production": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**"]
    },
    "@repo/i18n#build": {
      "outputs": ["src/paraglide/**"]
    },
    "deploy": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "deploy:preview": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "deploy:production": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check": {
      "dependsOn": ["^check", "^build"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "update": {
      "dependsOn": ["^update"],
      "cache": false
    },
    "install": {
      "dependsOn": ["^install"],
      "cache": false
    },
    "outdated": {
      "outputs": []
    },
    "machine-translate": {
      "outputs": ["src/paraglide/**"]
    },

    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.test.ts", "bunfig.toml"],
      "outputs": []
    },

    "test:watch": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.test.ts", "bunfig.toml"],
      "cache": false,
      "persistent": true
    },

    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.test.ts", "bunfig.toml"]
    }
  }
}
