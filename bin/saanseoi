#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"

while [[ -L "$script_path" ]]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"

  if [[ "$script_path" != /* ]]; then
    script_path="$link_dir/$script_path"
  fi
done

script_path="$(cd "$(dirname "$script_path")" && pwd)/$(basename "$script_path")"
repo_root="$(cd "$(dirname "$script_path")/.." && pwd)"

export SAANSEOI_INVOCATION_CWD="${SAANSEOI_INVOCATION_CWD:-$PWD}"
export SAANSEOI_COMMAND_PATH="$script_path"
cd "$repo_root"

# Keep one clean, append-only transcript for a top-level command and all of its
# child processes. The child wrappers inherit the redirected descriptors and
# SAANSEOI_LOG_ACTIVE, so an initialisation run does not create one log per step.
if [[ "${SAANSEOI_LOG_ACTIVE:-}" != 1 ]]; then
  command_name="${1:-help}"
  command_slug="${command_name//:/-}"
  command_slug="${command_slug//[^[:alnum:]_.-]/-}"
  log_timestamp="$(date -u +%Y%m%dT%H%M%S.%3NZ)"
  log_dir="$repo_root/logs"
  log_file="$log_dir/${command_slug}-${log_timestamp}.log"
  mkdir -p "$log_dir"
  {
    printf 'Command:'
    printf ' %q' "$@"
    printf '\nStarted: %s\n\n' "$log_timestamp"
  } > "$log_file"
  printf 'SaanSeoi log: %s\n' "${log_file#"$repo_root/"}" >&2

  # Clack uses CI mode to turn each redraw into a new line. stdout may be
  # intercepted by a terminal host, though, while stdin remains attached to
  # that terminal. Treat either descriptor being a TTY as interactive so the
  # cursor controls survive the proxy and replace the active line. This check
  # must happen before the descriptors below are redirected.
  export SAANSEOI_LOG_ACTIVE=1
  export SAANSEOI_LOG_PATH="$log_file"
  if [[ -t 1 || -t 0 ]]; then
    export CI=false
  else
    export CI=true
  fi
  exec > >(tee >(sed -u $'s/\033\\[[0-9;?]*[ -\\/]*[@-~]//g; s/\033\\][^\a]*(\a|\033\\\\)//g' >> "$log_file"))
  exec 2> >(tee >(sed -u $'s/\033\\[[0-9;?]*[ -\\/]*[@-~]//g; s/\033\\][^\a]*(\a|\033\\\\)//g' >> "$log_file") >&2)
else
  # Child invocations inherit the mode selected by the top-level wrapper.
  :
fi

exec "${SAANSEOI_BUN_PATH:-bun}" \
  --env-file="$repo_root/.env" \
  --env-file="$repo_root/.env.local" \
  --cwd ./apps/harbour-cli \
  ./src/cli.ts \
  "$@"
