{
  "extends": "../../libs/config-typescript/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "rootDir": "../../",
    "outDir": "dist",
    "types": ["bun-types"],
    "paths": {
      "@repo/core": ["../../libs/core/src/index.ts"],
      "@repo/core/d1ImportApi": ["../../libs/core/src/lib/d1ImportApi.ts"],
      "@repo/core/db/*": ["../../libs/core/src/lib/db/*"],
      "@repo/core/pipeline/*": ["../../libs/core/src/pipeline/*"],
      "@repo/core/uploadLocal": ["../../libs/core/src/lib/services/uploadLocal.ts"],
      "@repo/db": ["../../libs/db/src/index.ts"],
      "@repo/db/*": ["../../libs/db/src/*"],
      "drizzle-orm": ["../../libs/db/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../libs/db/node_modules/drizzle-orm/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
