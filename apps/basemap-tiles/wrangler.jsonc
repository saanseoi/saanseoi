{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ss-protomap",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "ss-pmtiles" }],
  // Shared with atlas-api production so both Workers resolve the same leases.
  "kv_namespaces": [
    {
      "binding": "PUBLIC_KEY_LEASES",
      "id": "c3f1cb8495d24f3d8e8719dec815bf00"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLIC_KEY_LEASE_COORDINATOR",
        "class_name": "PublicKeyLeaseCoordinator",
        "script_name": "ss-atlas-api-prod"
      }
    ]
  },
  "analytics_engine_datasets": [
    { "binding": "TILE_USAGE", "dataset": "ss-tile-usage-production" }
  ],
  "ratelimits": [
    {
      "name": "TILE_RATE_LIMIT",
      "namespace_id": "42004",
      "simple": { "limit": 3000, "period": 60 }
    }
  ],
  "routes": [{ "pattern": "tiles.saanseoi.hk", "custom_domain": true }],
  "vars": {
    "DIAGNOSTIC_ORIGINS": "https://maplibre.org,https://pmtiles.io,https://protomaps.github.io",
    "DEV_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175",
    "CORE_ORIGIN_SUFFIXES": "*.hype.hk,*.type.hk,*.saanseoi.hk",
    "HUB_ORIGINS": "https://hype.hk,https://breadline.hk,https://hkghostsigns.com",
    "PREVIEW_PREFIXES": "preview.",
    "EXTERNAL_ORIGINS": "*",
    "CACHE_CONTROL": "public, max-age=31536000, immutable",
    "PUBLIC_HOSTNAME": "tiles.saanseoi.hk",
    "AUTH_MODE": "required",
    "ENVIRONMENT": "production"
  },
  "minify": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "destinations": ["cloudflare"],
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "destinations": ["cloudflare"]
    }
  }
}
