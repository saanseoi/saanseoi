-    return FeatureMerge.mergeNearbyPolygons(items, Earth.MIN_AREA, Earth.MIN_AREA, 0.5, Earth.BUFFER);
+    var coastlineBase = items.stream()
+      .filter(item -> Boolean.TRUE.equals(item.attrs().get(RegionalCoastline.BASE_ATTRIBUTE)))
+      .toList();
+    var ordinaryItems = items.stream()
+      .filter(item -> !Boolean.TRUE.equals(item.attrs().get(RegionalCoastline.BASE_ATTRIBUTE)))
+      .toList();
+    var processed = FeatureMerge.mergeLineStrings(ordinaryItems, 0.5, Earth.PIXEL_TOLERANCE, 4.0);
+    processed = FeatureMerge.mergeNearbyPolygons(processed, Earth.MIN_AREA, Earth.MIN_AREA, 0.5, Earth.BUFFER);
+    if (coastlineBase.isEmpty()) {
+      return processed;
+    }
+    var result = new java.util.ArrayList<>(processed);
+    result.addAll(coastlineBase);
+    return result;
   }
 }
