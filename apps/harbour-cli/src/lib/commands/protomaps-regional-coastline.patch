diff --git a/tiles/src/main/java/com/protomaps/basemap/layers/RegionalCoastline.java b/tiles/src/main/java/com/protomaps/basemap/layers/RegionalCoastline.java
new file mode 100644
index 0000000..372914a
--- /dev/null
+++ b/tiles/src/main/java/com/protomaps/basemap/layers/RegionalCoastline.java
@@ -0,0 +1,54 @@
+package com.protomaps.basemap.layers;
+
+import com.onthegomap.planetiler.FeatureCollector;
+import com.onthegomap.planetiler.reader.SourceFeature;
+
+/** Emits exact, pre-clipped regional base geometry in the standard Protomaps layers. */
+public class RegionalCoastline {
+
+  public static final String BASE_ATTRIBUTE = "saanseoi:base";
+
+  public void processLand(SourceFeature sf, FeatureCollector features) {
+    features.polygon(Earth.LAYER_NAME)
+      .setAttr("kind", "earth")
+      .setAttr(BASE_ATTRIBUTE, true)
+      .setMinZoom(0)
+      .setMinPixelSize(1)
+      .setPixelTolerance(Earth.PIXEL_TOLERANCE)
+      .setBufferPixels(8);
+  }
+
+  public void processWater(SourceFeature sf, FeatureCollector features) {
+    features.polygon(Water.LAYER_NAME)
+      .setAttr("kind", "ocean")
+      .setAttr("sort_rank", 200)
+      .setAttr(BASE_ATTRIBUTE, true)
+      .setMinZoom(0)
+      .setMinPixelSize(1)
+      .setPixelTolerance(Earth.PIXEL_TOLERANCE)
+      .setBufferPixels(8);
+  }
+
+  public void processCoastline(SourceFeature sf, FeatureCollector features) {
+    features.line(Water.LAYER_NAME)
+      .setAttr("kind", "coastline")
+      .setAttr(BASE_ATTRIBUTE, true)
+      .setMinZoom(0)
+      .setMinPixelSize(1)
+      .setPixelTolerance(Earth.PIXEL_TOLERANCE)
+      .setBufferPixels(8);
+  }
+
+  /** Emits only landward footprint segments into the standard boundaries layer. */
+  public void processBorder(SourceFeature sf, FeatureCollector features) {
+    features.line(Boundaries.LAYER_NAME)
+      .setAttr("kind", "region")
+      .setAttr("kind_detail", 4)
+      .setAttr("sort_rank", 289)
+      .setAttr("saanseoi:region_border", true)
+      .setAttr(BASE_ATTRIBUTE, true)
+      .setMinZoom(6)
+      .setMinPixelSize(0)
+      .setBufferPixels(8);
+  }
+}
