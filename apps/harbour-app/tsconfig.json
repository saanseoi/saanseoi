{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun", "vite/client"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "#lib/*": ["../atlas-app/src/lib/*"],
      "#lib/bits/internal/i18n.js": ["../../libs/i18n/src/messages.ts"]
    }
  },
  "include": ["src/**/*", "ingestion/**/*", "tests/**/*", "*.ts"]
}
