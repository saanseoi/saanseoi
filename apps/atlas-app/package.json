{
  "name": "atlas-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "i18n:build": "bun run --cwd ../.. --filter @repo/i18n build",
    "build": "bun run i18n:build && vite build && wrangler types --env-interface Env",
    "build:preview": "bun run i18n:build && vite build && wrangler types --env-interface Env",
    "build:production": "bun run i18n:build && vite build && wrangler types --env-interface Env",
    "deploy": "bun run build:production && wrangler deploy --env production",
    "deploy:preview": "bun run build:preview && wrangler deploy --env preview",
    "deploy:production": "bun run build:production && wrangler deploy --env production",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run i18n:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run i18n:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cf-typegen": "wrangler types --env-interface Env",
    "test": "bun test --path-ignore-patterns 'src/**/*.svelte.{test,spec}.{js,ts}'",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@better-auth/core": "1.7.1",
    "@better-auth/passkey": "1.7.1",
    "@humanspeak/svelte-markdown": "^1.8.7",
    "@iconify-svelte/emojione-monotone": "1.0.3",
    "@iconify-svelte/hugeicons": "1.0.18",
    "@iconify-svelte/ion": "1.0.3",
    "@iconify-svelte/lucide": "1.0.58",
    "@iconify-svelte/material-symbols-light": "1.0.49",
    "@iconify-svelte/proicons": "1.0.5",
    "@iconify-svelte/simple-icons": "1.0.41",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@protomaps/basemaps": "^5.7.2",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@scalar/api-reference": "^1.66.1",
    "better-auth": "1.7.1",
    "bits-ui": "^2.19.0",
    "diff": "^9.0.0",
    "github-slugger": "^2.0.0",
    "leaflet": "1.9.4",
    "mapbox-gl": "3.28.1",
    "maplibre-gl": "^6.6.0",
    "svelte-maplibre-gl": "^2.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "next",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "1.9.21",
    "@types/node": "^26.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^3.0.0",
    "wrangler": "^4.125.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
