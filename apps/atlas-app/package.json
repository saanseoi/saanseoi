{
  "name": "atlas-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "i18n:build": "bun run --cwd ../.. --filter @repo/i18n build",
    "build": "bun run i18n:build && vite build && wrangler types --env-interface Env",
    "build:preview": "bun run i18n:build && vite build && wrangler types --env-interface Env",
    "build:production": "bun run i18n:build && vite build && wrangler types --env-interface Env",
    "deploy": "bun run build:production && wrangler deploy --env production",
    "deploy:preview": "bun run build:preview && wrangler deploy --env preview",
    "deploy:production": "bun run build:production && wrangler deploy --env production",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run i18n:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cf-typegen": "wrangler types --env-interface Env",
    "test": "bun test --path-ignore-patterns 'src/**/*.svelte.{test,spec}.{js,ts}'",
    "test:browser": "svelte-kit sync && vitest run --project client",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "review:release-tabs": "bun ./scripts/open-release-review-tabs.ts",
    "test:audit-page": "bun ./scripts/test-audit-page.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "@humanspeak/svelte-markdown": "^2.1.3",
    "@iconify-svelte/emojione-monotone": "1.0.3",
    "@iconify-svelte/hugeicons": "1.0.20",
    "@iconify-svelte/ion": "1.0.3",
    "@iconify-svelte/lucide": "1.0.66",
    "@iconify-svelte/material-symbols-light": "1.0.53",
    "@iconify-svelte/proicons": "1.0.5",
    "@iconify-svelte/simple-icons": "1.0.44",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@protomaps/basemaps": "^5.7.2",
    "@repo/basemap": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@scalar/api-reference": "^1.75.0",
    "@tanstack/svelte-virtual": "^3.13.47",
    "@turf/turf": "^7.4.0",
    "better-auth": "1.7.10",
    "bits-ui": "^2.19.5",
    "diff": "^9.0.0",
    "geos-wasm": "3.1.1",
    "github-slugger": "^2.0.0",
    "leader-line": "1.0.8",
    "leaflet": "1.9.4",
    "mapbox-gl": "3.33.0",
    "maplibre-gl": "^6.15.0",
    "svelte-maplibre-gl": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0",
    "wrangler": "^4.151.1",
    "xlsx": "^0.18.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
